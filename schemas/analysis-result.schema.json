{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SorobanLabs/sorobanlabs-analyzer/schemas/analysis-result.schema.json",
  "title": "SorobanLabs Analyzer canonical analysis report",
  "description": "Schema version 1.0.0. Describes the shape produced by analyzer_report::to_canonical_json for analyzer_report::AnalysisReport. This schema is versioned independently of the analyzer's own release version; a change that could break an existing consumer requires a new schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer_version",
    "protocol_context",
    "current_executable",
    "candidate_executable",
    "status",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "The canonical report schema version this document conforms to.",
      "const": "1.0.0"
    },
    "analyzer_version": {
      "type": "string",
      "description": "The analyzer release version that produced this report."
    },
    "protocol_context": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "The Soroban protocol number the analysis was run against, or null if none was specified."
    },
    "current_executable": {
      "$ref": "#/$defs/executableIdentity"
    },
    "candidate_executable": {
      "$ref": "#/$defs/executableIdentity"
    },
    "status": {
      "type": "string",
      "enum": [
        "NO_DETECTED_BLOCKERS",
        "REVIEW_REQUIRED",
        "MIGRATION_REQUIRED",
        "INCONCLUSIVE",
        "ANALYSIS_ERROR"
      ]
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "executableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "byte_length"],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex SHA-256 of the exact executable bytes."
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "rule",
        "subject",
        "summary",
        "detail",
        "severity",
        "confidence",
        "evidence",
        "remediation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Deterministic SHA-256 of (category, rule, subject); independent of human-readable text."
        },
        "category": {
          "type": "string",
          "enum": [
            "executable",
            "environment",
            "interface",
            "state",
            "authorization",
            "rehearsal",
            "resource"
          ]
        },
        "rule": {
          "type": "string",
          "enum": [
            "EXECUTABLE_HASH_CHANGED",
            "EXECUTABLE_STRUCTURALLY_INCOMPATIBLE",
            "ENVIRONMENT_INTERFACE_CHANGED",
            "ENVIRONMENT_METADATA_MISSING",
            "CONTRACT_INTERFACE_ADDED",
            "CONTRACT_INTERFACE_REMOVED",
            "CONTRACT_SIGNATURE_CHANGED",
            "CONTRACT_EVENT_CHANGED",
            "CONTRACT_TYPE_CHANGED",
            "STATE_SCHEMA_CHANGED",
            "MIGRATION_REQUIRED",
            "STATE_COMPATIBILITY_UNKNOWN",
            "AUTHORIZATION_SURFACE_CHANGED",
            "AUTHORIZATION_REMOVED",
            "REHEARSAL_RESULT_CHANGED",
            "REHEARSAL_STATE_CHANGED",
            "REHEARSAL_EVENT_CHANGED",
            "REHEARSAL_FAILED",
            "REHEARSAL_ERROR_CHANGED",
            "REHEARSAL_AUTHORIZATION_CHANGED",
            "REHEARSAL_RESOURCE_CHANGED",
            "REHEARSAL_OBSERVATION_INCOMPLETE",
            "RESOURCE_USAGE_CHANGED"
          ]
        },
        "subject": { "type": "string" },
        "summary": { "type": "string" },
        "detail": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "confidence": {
          "type": "string",
          "enum": ["DETECTED", "LIKELY", "POTENTIAL", "NOT_DETERMINABLE"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "remediation": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
